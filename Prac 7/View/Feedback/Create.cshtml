@model Practical_7.Model.Feedback

@{
    ViewBag.Title = "Give Feedback";
    Layout = "~/View/Shared/_Layout.cshtml";
}

<h2>Give Feedback</h2>

@using (Html.BeginForm("Create", "Feedback", FormMethod.Post))
{
    @Html.ValidationSummary(true, "", new { @class = "error" })

    <div>
        @Html.LabelFor(model => model.StudentName)
        <br />

        @Html.TextBoxFor(
            model => model.StudentName,
            new { placeholder = "Enter student name" }
        )

        <br />

        @Html.ValidationMessageFor(
            model => model.StudentName,
            "",
            new { @class = "error" }
        )
    </div>

    <br />

    <div>
        @Html.LabelFor(model => model.FacultyName)
        <br />

        @Html.TextBoxFor(
            model => model.FacultyName,
            new { placeholder = "Enter faculty name" }
        )

        <br />

        @Html.ValidationMessageFor(
            model => model.FacultyName,
            "",
            new { @class = "error" }
        )
    </div>

    <br />

    <div>
        @Html.LabelFor(model => model.CourseName)
        <br />

        @Html.TextBoxFor(
            model => model.CourseName,
            new { placeholder = "Enter course name" }
        )

        <br />

        @Html.ValidationMessageFor(
            model => model.CourseName,
            "",
            new { @class = "error" }
        )
    </div>

    <br />

    <div>
        @Html.LabelFor(model => model.Rating)
        <br />

        @Html.DropDownListFor(
            model => model.Rating,
            new SelectList(new[]
            {
                new { Value = 1, Text = "1 - Poor" },
                new { Value = 2, Text = "2 - Fair" },
                new { Value = 3, Text = "3 - Good" },
                new { Value = 4, Text = "4 - Very Good" },
                new { Value = 5, Text = "5 - Excellent" }
            }, "Value", "Text"),
            "-- Select Rating --"
        )

        <br />

        @Html.ValidationMessageFor(
            model => model.Rating,
            "",
            new { @class = "error" }
        )
    </div>

    <br />

    <div>
        @Html.LabelFor(model => model.Comments)
        <br />

        @Html.TextAreaFor(
            model => model.Comments,
            5,
            40,
            new { placeholder = "Enter your feedback" }
        )

        <br />

        @Html.ValidationMessageFor(
            model => model.Comments,
            "",
            new { @class = "error" }
        )
    </div>

    <br />

    <input type="submit" value="Submit Feedback" class="btn" />
}